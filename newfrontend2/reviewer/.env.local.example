# Local integration: point the Next proxies at the standalone reviewer backend (:8105)
BACKEND_SERVICE_URL=
GLIMMORA_API_BASE_URL=
NEXT_PUBLIC_GLIMMORA_API_URL=
# AUTH_SECRET must equal the backend API_SECRET_KEY so JWTs verify both ways
AUTH_SECRET=REPLACE_ME
NEXTAUTH_SECRET=REPLACE_ME
# Prisma (node-postgres) connection — SAME Neon DB as the backend, just in the
# libpq form Prisma needs (no +asyncpg driver suffix; ssl=require -> sslmode=require).
# Used by the shared auth routes (password change, durable session upsert).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
